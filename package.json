{
  "name": "helpdesk-jarvis",
  "productName": "Helpdesk Jarvis",
  "description": "IT Helpdesk Management System",
  "version": "1.1.0",
  "main": "Backend/server.js",
  "homepage": "./",
  "scripts": {
    "start": "node Backend/server.js",
    "start:backend": "cd Backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd Backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "echo 'Backend build complete (no build step needed)'",
    "post-build": "node scripts/post-build.js",
    "build": "npm run build:frontend && npm run build:backend && npm run post-build",
    "copy-native-binaries": "node scripts/copy-native-binaries.js",
    "dist:win": "npm run build && npm run copy-native-binaries && pkg Backend/server.js --targets node22-win-x64 --output releases/helpdesk-jarvis.exe",
    "dist:win:versioned": "npm run build && npm run copy-native-binaries && node scripts/version-build.js",
    "install-deps": "npm install && cd Backend && npm install && cd ../frontend && npm install",
    "release": "npm run dist:win:versioned"
  },
  "pkg": {
    "assets": [
      "Backend/**/*",
      "Backend/node_modules/bcrypt/lib/binding/napi-v3/bcrypt_lib.node",
      "Backend/node_modules/better-sqlite3/lib/binding/node-v127-win32-x64/better_sqlite3.node",
      "frontend/build/**/*",
      "Tools/**/*",
      "setupConfig.js"
    ],
    "scripts": [
      "Backend/**/*.js"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "releases/"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "node-gyp": "^11.4.2"
  }
}
